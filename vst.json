{
  "name": "DINXXL",
  "vendor": "L'Cronx",
  "uid": "DnXL",
  "version": 100,
  "so": "dinxxl.so",
  "params": "params.json",
  "art": "html",
  "build": {
    "root": ".",
    "sources": [
      "src/engine.cc"
    ],
    "cflags": [
      "-Isrc"
    ],
    "libs": [
      "-lm",
      "-ldl",
      "-lpthread"
    ]
  },
  "layout": "layout.conf",
  "title_font": "art/fonts/ChakraPetch-SemiBold.ttf",
  "defines": {
    "HAS_DISPLAY_REV": 1,
    "PARAM_TEXT_MAX": 64,
    "DISPLAY_REV_NO_UPDATE": 1,
    "SAMPLE_ACCURATE": 1,
    "MODULE_SUBDIR": "\"card\"",
    "HAS_SONG_POS": 1
  },
  "tile": "art/tile.png"
}